<%@ Page Language="C#" AutoEventWireup="true" CodeBehind="Register.aspx.cs" Inherits="BANKAPPPROJECT.Register" %>
<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml" lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Register — BankApp</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <style>
        :root {
            --bg: #f5f7fb;
            --surface: #ffffff;
            --text: #0a2540;
            --muted: #5b6b82;
            --primary: #0a2540;
            --primary-hover: #1a3a5c;
            --accent: #00c2a8;
            --border: #e6ebf2;
            --danger: #e0345a;
            --radius: 16px;
            --shadow: 0 4px 24px rgba(10,37,64,0.10);
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }

        html, body {
            min-height: 100vh;
            background: var(--bg);
            font-family: 'Inter', -apple-system, sans-serif;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 24px;
        }

        .register-wrap {
            width: 100%;
            max-width: 460px;
        }

        .brand {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            margin-bottom: 28px;
            color: var(--text);
            font-size: 22px;
            font-weight: 800;
            letter-spacing: -0.02em;
        }

        .brand-mark {
            width: 40px; height: 40px;
            border-radius: 12px;
            background: linear-gradient(135deg, #0a2540, #0a66ff);
            display: grid; place-items: center;
            color: #fff;
            font-weight: 800;
            font-size: 18px;
        }

        .card {
            background: var(--surface);
            border-radius: var(--radius);
            padding: 36px;
            box-shadow: var(--shadow);
            border: 1px solid var(--border);
        }

        .card h2 {
            font-size: 22px;
            font-weight: 700;
            color: var(--text);
            margin-bottom: 6px;
            letter-spacing: -0.01em;
        }

        .card .subtitle {
            font-size: 14px;
            color: var(--muted);
            margin-bottom: 24px;
        }

        label {
            display: block;
            margin: 16px 0 6px;
            font-size: 13px;
            font-weight: 600;
            color: var(--text);
        }

        input {
            width: 100%;
            padding: 11px 14px;
            border: 1.5px solid var(--border);
            border-radius: 10px;
            font-size: 14px;
            font-family: 'Inter', sans-serif;
            color: var(--text);
            background: var(--bg);
            outline: none;
            transition: border-color .2s, box-shadow .2s;
        }

        input:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(10,37,64,0.08);
            background: #fff;
        }

        .btn {
            width: 100%;
            padding: 13px;
            background: var(--primary);
            color: #fff;
            border: none;
            border-radius: 10px;
            font-size: 15px;
            font-weight: 600;
            font-family: 'Inter', sans-serif;
            cursor: pointer;
            margin-top: 24px;
            transition: background .15s, transform .15s, box-shadow .15s;
            box-shadow: 0 2px 8px rgba(10,37,64,0.15);
            letter-spacing: 0.01em;
        }

        .btn:hover {
            background: var(--primary-hover);
            transform: translateY(-1px);
            box-shadow: 0 6px 16px rgba(10,37,64,0.2);
        }

        .msg {
            padding: 12px 16px;
            border-radius: 10px;
            margin-top: 14px;
            font-size: 14px;
            font-weight: 500;
        }

        .err {
            background: #fff0f3;
            color: var(--danger);
            border: 1px solid #fcc;
        }

        .ok {
            background: #f0fdf8;
            color: #00856e;
            border: 1px solid #b3f0e6;
        }

        .footer-link {
            text-align: center;
            margin-top: 20px;
            font-size: 14px;
            color: var(--muted);
        }

        .footer-link a {
            color: var(--primary);
            font-weight: 600;
            text-decoration: underline;
            text-underline-offset: 3px;
        }

        .footer-link a:hover {
            color: var(--primary-hover);
        }

        .divider {
            border: none;
            border-top: 1px solid var(--border);
            margin: 24px 0 0;
        }

        .two-col {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
        }

        @media (max-width: 480px) {
            .two-col { grid-template-columns: 1fr; }
            .card { padding: 24px; }
        }
    </style>
</head>
<body>
<form id="form1" runat="server">
<div class="register-wrap">
    <div class="brand">
        <div class="brand-mark">B</div>
        <span>BankApp</span>
    </div>
    <div class="card">
        <h2>Create an account</h2>
        <p class="subtitle">Fill in the details below to get started.</p>

        <div class="two-col">
            <div>
                <label>Username</label>
                <asp:TextBox ID="txtUsername" runat="server" />
            </div>
            <div>
                <label>Full Name</label>
                <asp:TextBox ID="txtFullName" runat="server" />
            </div>
        </div>

        <label>Email</label>
        <asp:TextBox ID="txtEmail" runat="server" TextMode="Email" />

        <hr class="divider" style="margin-top:20px;" />

        <div class="two-col">
            <div>
                <label>Password</label>
                <asp:TextBox ID="txtPassword" runat="server" TextMode="Password" />
            </div>
            <div>
                <label>Confirm Password</label>
                <asp:TextBox ID="txtConfirm" runat="server" TextMode="Password" />
            </div>
        </div>

        <asp:Button ID="btnRegister" runat="server" Text="Create Account" CssClass="btn" OnClick="btnRegister_Click" />
        <asp:Label ID="lblMsg" runat="server" />

        <hr class="divider" />
        <div class="footer-link">
            Already have an account? <a href="Login.aspx">Sign in</a>
        </div>
    </div>
</div>
</form>
</body>
</html>